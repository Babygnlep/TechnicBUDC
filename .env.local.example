# Example environment variables for Google Calendar (do NOT commit real keys)
# Create a Google Cloud service account with Calendar API enabled.
# Share the target calendar with the service account email.

GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# For the private key, wrap it in quotes and replace actual newlines with \n when placing in env.
# Example: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# Optional: timezone used for created events (default: Asia/Bangkok)
GOOGLE_CALENDAR_TIMEZONE=Asia/Bangkok

# Optional: disable Google Calendar integration entirely (useful for local dev)
# Set to "true" to skip attempts to create events in Google Calendar.
DISABLE_GOOGLE_CALENDAR=false

# Persistent storage for schedule entries. This is required for deployments on Vercel;
# files written by Vercel functions are temporary and are not a backup.
# Use a PostgreSQL connection string from Neon, Vercel Postgres, Supabase, etc.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# User password: view schedule and submit available dates.
# SCHEDULE_ACCESS_PASSWORD is also supported for backwards compatibility.
SCHEDULE_USER_PASSWORD=replace-with-a-long-private-user-password
# Admin password: all user permissions plus delete schedule entries and signer records.
SCHEDULE_ADMIN_PASSWORD=replace-with-a-different-long-private-admin-password
